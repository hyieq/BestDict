{
  "name": "bestdict",
  "version": "0.4.20",
  "private": true,
  "description": "A quiet, offline-first bilingual desktop dictionary",
  "author": "BestDict",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:unit": "node --test tests/resources.test.cjs tests/hy.test.cjs tests/query-policy.test.cjs tests/updates.test.cjs tests/release.test.cjs tests/speech-cache.test.cjs tests/speech-standby.test.cjs tests/speech-stream.test.cjs",
    "test:desktop": "node scripts/smoke.mjs",
    "test:glass": "node scripts/glass-ui-smoke.mjs",
    "test:mini": "node scripts/mini-ui-smoke.mjs",
    "test:capture": "node scripts/capture-ui-smoke.mjs",
    "test:translation-ui": "node scripts/translation-ui-smoke.mjs",
    "test:multilingual": "node scripts/multilingual-smoke.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "test:ai-styles": "node scripts/ai-style-smoke.mjs",
    "test:ai-menu": "node scripts/ai-menu-smoke.mjs",
    "test:query-mode": "node scripts/query-mode-smoke.mjs",
    "test:speech": "node scripts/speech-ui-smoke.mjs && node scripts/speech-stream-ui-smoke.mjs",
    "test:settings": "node scripts/settings-ui-smoke.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0",
    "playwright": "^1.58.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "overrides": {
    "pe-library": "0.4.1"
  },
  "build": {
    "appId": "com.bestdict.desktop",
    "productName": "BestDict",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "runtime/python",
        "to": "python",
        "filter": [
          "**/*",
          "!**/rapidocr/models/**/*"
        ]
      },
      {
        "from": "runtime/llama",
        "to": "llama"
      },
      {
        "from": "resources",
        "to": "assets",
        "filter": [
          "**/*",
          "!models/**/*",
          "!**/*.gguf",
          "!**/*.argosmodel",
          "!asset-manifest.json",
          "!branding/**/*"
        ]
      },
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "*.py",
          "*.ps1"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "guid": "102f0267-47de-59cc-9d18-1c34dd13cce3",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BestDict",
      "include": "scripts/installer.nsh"
    },
    "artifactName": "BestDict-${version}-${arch}-Setup.${ext}",
    "afterPack": "scripts/sign-macos-runtime.cjs",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/branding/app-icon-source.png",
      "category": "public.app-category.reference",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "artifactName": "BestDict-${version}-macOS-${arch}.${ext}"
    }
  }
}
