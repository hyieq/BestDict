{
  "name": "bestdict",
  "version": "0.4.7",
  "private": true,
  "description": "A quiet, offline-first bilingual desktop dictionary",
  "author": "BestDict",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:unit": "node --test tests/resources.test.cjs tests/hy.test.cjs tests/query-policy.test.cjs",
    "test:desktop": "node scripts/smoke.mjs",
    "test:translation-ui": "node scripts/translation-ui-smoke.mjs",
    "test:multilingual": "node scripts/multilingual-smoke.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "test:ai-styles": "node scripts/ai-style-smoke.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0",
    "playwright": "^1.58.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "overrides": {
    "pe-library": "0.4.1"
  },
  "build": {
    "appId": "com.bestdict.desktop",
    "productName": "BestDict",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "runtime/python",
        "to": "python"
      },
      {
        "from": "runtime/llama",
        "to": "llama"
      },
      {
        "from": "resources",
        "to": "assets",
        "filter": [
          "**/*",
          "!models/**/*",
          "!**/*.gguf",
          "!**/*.argosmodel",
          "!asset-manifest.json",
          "!branding/**/*"
        ]
      },
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "*.py"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "guid": "102f0267-47de-59cc-9d18-1c34dd13cce3",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BestDict",
      "include": "scripts/installer.nsh"
    },
    "artifactName": "BestDict-${version}-${arch}-Setup.${ext}"
  }
}
